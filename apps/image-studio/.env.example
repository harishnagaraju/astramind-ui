# Public URL of your ComfyUI instance, e.g. your Jarvislabs notebook URL.
# Find it with: curl https://<your-instance>.jarvislabs.net/system_stats
# The dev server proxies /comfyui-api to this address (see vite.config.ts)
# so the browser never has to make a cross-origin request to ComfyUI.
VITE_COMFYUI_BASE_URL=https://9a969c4678831.notebooksn.jarvislabs.net

# Which workflow graph to use: "stable-diffusion" (default) or "flux-kontext".
VITE_COMFYUI_MODEL_FAMILY=flux-kontext

# --- stable-diffusion family (ignored when MODEL_FAMILY=flux-kontext) ---
# Optional: pin a specific checkpoint filename. If omitted, the connector
# uses the first checkpoint reported by ComfyUI's /object_info endpoint.
# VITE_COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors

# --- flux-kontext family ---
# Defaults below already match the files confirmed on your instance via
# /object_info/UNETLoader, /DualCLIPLoader, /VAELoader. Only set these if
# your instance uses different filenames.
# VITE_COMFYUI_FLUX_UNET=flux1-dev-kontext_fp8_scaled.safetensors
# VITE_COMFYUI_FLUX_CLIP_L=clip_l.safetensors
# VITE_COMFYUI_FLUX_CLIP_T5=t5xxl_fp8_e4m3fn_scaled.safetensors
# VITE_COMFYUI_FLUX_VAE=ae.safetensors
# VITE_COMFYUI_FLUX_GUIDANCE=2.5
