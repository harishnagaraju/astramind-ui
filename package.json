{
  "name": "astramind-ui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "build": "pnpm --recursive run build",
    "check": "pnpm --recursive run check",
    "dev": "pnpm --filter @astramind/image-studio dev",
    "lint": "pnpm --recursive run lint",
    "test": "pnpm --recursive run test",
    "format": "prettier --write .",
    "setup:connector": "bash scripts/setup_astramind_connector.sh",
    "config:env": "bash scripts/update-env.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
